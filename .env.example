# Local development only. Change the password when the database is exposed beyond localhost.
POSTGRES_USER=ai_liver
POSTGRES_PASSWORD=ai_liver_password
POSTGRES_DB=ai_liver
POSTGRES_PORT=5432

# The application reads this variable through services.topic_memory_database.dsn_env.
AI_LIVER_DATABASE_URL=postgresql://ai_liver:ai_liver_password@127.0.0.1:5432/ai_liver
